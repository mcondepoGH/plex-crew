# Copia este fichero a ~/.claude/plex-crew/.env y rellena los valores. Nunca se sube al repositorio.
# Rellena solo los servicios que uses; las skills de los demás simplemente no funcionarán.

# Las URL van sin barra final (http://host:puerto, no http://host:puerto/).
# Los ajustes opcionales (PLEX_CREW_CONFIG...) están al final, comentados.

# Prowlarr: búsqueda en indexadores y gestión de indexadores (skill prowlarr).
PROWLARR_URL=
PROWLARR_API_KEY=

# Radarr: gestión de películas (skill radarr).
RADARR_URL=
RADARR_API_KEY=

# Sonarr: gestión de series (skill sonarr).
SONARR_URL=
SONARR_API_KEY=

# Plex Media Server: bibliotecas, búsqueda y sesiones (skill plex).
PLEX_URL=
PLEX_TOKEN=

# Tautulli: estadísticas y actividad de Plex (skill tautulli).
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Seerr / Overseerr: solicitudes de contenido (skill seerr).
SEERR_URL=
SEERR_API_KEY=

# cli_debrid: estado, cola y logs (skill cli_debrid).
CLI_DEBRID_URL=
CLI_DEBRID_USER=
CLI_DEBRID_PASSWORD=

# ruTorrent: torrents por la API web con autenticación básica (skill rutorrent).
RUTORRENT_URL=
RUTORRENT_USER=
RUTORRENT_PASSWORD=

# Agregarr: listas y colecciones para Plex (skill agregarr). Nueva en 0.3.0.
AGREGARR_URL=
AGREGARR_API_KEY=

# --- Ajustes opcionales (descomenta solo si los necesitas) ---

# Ruta alternativa a ~/.claude/plex-crew/scope.conf. Lo leen AMBOS hooks y debe definirse
# en el entorno de la shell (export), no en este fichero.
# PLEX_CREW_CONFIG=

# Prefijo (ruta DENTRO del contenedor de ruTorrent) donde se permite crear torrents y borrar datos
# (p. ej. /data/downloads/seed). Si no se define, solo rigen las reglas de movies/shows y .@*.
# RUTORRENT_ALLOWED_DIR=

# ID del perfil de calidad con el que Radarr añade películas (ver `radarr.sh config`; por defecto 1).
# RADARR_DEFAULT_QUALITY_PROFILE=

# ID del perfil de calidad con el que Sonarr añade series (ver `sonarr.sh config`; por defecto 1).
# SONARR_DEFAULT_QUALITY_PROFILE=
