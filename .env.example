# Copia este fichero a .env y rellena los valores. .env no se sube al repositorio.
# Rellena solo los servicios que uses; las skills de los demás simplemente no funcionarán.

# Opcional: ruta alternativa al fichero de credenciales. Si no se define, se usa el .env
# de la raíz del repositorio. Lo leen las skills (_lib/load-env.sh) y scripts/start.sh.
# HOMELAB_ENV=/ruta/a/otro/.env

# Prowlarr: búsqueda en indexadores y gestión de indexadores (skill prowlarr).
PROWLARR_URL=
PROWLARR_API_KEY=

# Radarr: gestión de películas (skill radarr). El perfil de calidad por defecto es opcional.
RADARR_URL=
RADARR_API_KEY=
RADARR_DEFAULT_QUALITY_PROFILE=

# Sonarr: gestión de series (skill sonarr). El perfil de calidad por defecto es opcional.
SONARR_URL=
SONARR_API_KEY=
SONARR_DEFAULT_QUALITY_PROFILE=

# Plex Media Server: bibliotecas, búsqueda y sesiones (skill plex).
PLEX_URL=
PLEX_TOKEN=

# Tautulli: estadísticas y actividad de Plex (skill tautulli).
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Seerr / Overseerr: solicitudes de contenido (skill seerr).
SEERR_URL=
SEERR_API_KEY=

# cli_debrid: estado, cola y logs (skill cli_debrid).
CLI_DEBRID_URL=
CLI_DEBRID_USER=
CLI_DEBRID_PASSWORD=

# URL del MCP nativo de zurg (la lee .mcp.json como ${ZURG_MCP_URL}). Sin valor por defecto.
ZURG_MCP_URL=http://<host-zurg>:9999/mcp
